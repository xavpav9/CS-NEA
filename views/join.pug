extends layout
  
block head
  title Hearts
  link(href="/stylesheets/style.css", rel="stylesheet")
  script(src="/scripts/join.js", defer)

block content
  h1 Join table

  form(id="join-form", action="/join", method="post")
    input(type="hidden", id="game-id", name="gameID", value="1")
    if gameIDs
      each gameID, index in gameIDs
        button(class="join-btn" data-gameid=gameID) Join table #{index + 1}

  dialog
